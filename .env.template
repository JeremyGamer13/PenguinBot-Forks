TOKEN_TEST="discord bot token..."

# SETTINGS
PREFIX="pmai!"
PREFIX_TEST="pmait!"
OWNER="462098932571308033"
SERVER_ID="1033551490331197462" # Used for anything server-specific.
CLEANUP_FOLDER_TEMP="true" # Deletes all files in the temp directory on reboot. Doesnt apply in test mode
CONNECTIVITY_CHECK_FOR_OFFLINE="true" # Waits until we can fetch discord.com before logging in. Intended to check for the host's internet connectivity, this is NOT built to handle Discord API outages.
CONNECTIVITY_CHECK_MAX="50" # max amounts of checks before we just give up and panic
CONNECTIVITY_CHECK_DELAY="60000" # ms between connectivity checks
RESPOND_TO_KEYWORDS="true"
USE_RESTART_MESSAGE="true" # On pm!restart, Reply to the  restartMessage in the restartChannel if present in state.serialized
PREVENT_UPDATES="false"
DISABLE_GIT="true" # disables the use of Git CLI (for commands like pm!pull)
DISABLE_GIT_WRITE="true" # disables the use of Git CLI for writing to a repo (for commands like pm!push)
DISABLE_ARBITRARY_OS_LEVEL_CODE="true" # Disables the eval & installmodule commands
DISABLE_FORKING="false" # Disables the use of multi-threading in the multi-thread module, specifically child_process.fork()
STATE_DEFAULT_ENABLEDAI="true" # sets enabledAi on startup
STATE_DEFAULT_ENABLEDMARKOV="false" # sets enabledMarkov on startup. use a Markov chain method to run the AI much cheaper on CPU when the main model is unavailable

# OLLAMA
